@using AIMS.Entities
@{
    ViewData["Title"] = "New purchase order";
    Layout = "_PrivateLayout";

    var suppliers = ViewBag.Suppliers as List<Supplier> ?? new List<Supplier>();
    var products = ViewBag.Products as List<Product> ?? new List<Product>();
}

<link rel="stylesheet" href="~/css/Purchase/Purchase.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/Purchase/CreatePurchase.css" asp-append-version="true" />

<div class="purchase-page create-purchase-page">
    <div class="purchase-heading">
        <div>
            <div class="purchase-eyebrow">PURCHASE MANAGEMENT</div>
            <h1>New purchase order</h1>
            <p>Create a supplier order and add the products you want to purchase.</p>
        </div>
        <a class="purchase-btn purchase-btn-light" asp-controller="Purchase" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Back to purchases
        </a>
    </div>

    <form asp-controller="Purchase" asp-action="Create" method="post" id="purchaseForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="create-validation"></div>

        <section class="create-card">
            <div class="create-card-heading">
                <div>
                    <h2><span>01</span> Supplier information</h2>
                    <p>Select the supplier and expected delivery date.</p>
                </div>
            </div>

            <div class="create-form-grid">
                <div class="create-field">
                    <label for="supplierId">Supplier <span>*</span></label>
                    <select id="supplierId" name="supplierId" required>
                        <option value="">Select supplier</option>
                        @foreach (var supplier in suppliers)
                        {
                            <option value="@supplier.SupplierId"
                                    data-address="@supplier.Address"
                                    data-terms="@supplier.PaymentTermsDays">
                                @supplier.Name
                            </option>
                        }
                    </select>
                    <span class="create-field-error">@Html.ValidationMessage("supplierId")</span>
                </div>
                <div class="create-field">
                    <label for="expectedDate">Expected delivery date</label>
                    <input type="date" id="expectedDate" name="expectedDate"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="create-field create-field-full">
                    <label>Supplier address</label>
                    <div class="create-readonly" id="supplierAddress">Select a supplier to view its address.</div>
                </div>
            </div>
        </section>

        <section class="create-card">
            <div class="create-card-heading create-items-heading">
                <div>
                    <h2><span>02</span> Order items</h2>
                    <p>Add products, quantities and purchase unit costs.</p>
                </div>
                <button type="button" class="create-add-line" id="addLineButton">
                    <i class="bi bi-plus-lg"></i> Add product
                </button>
            </div>

            <div class="create-items-table-wrap">
                <table class="create-items-table">
                    <thead>
                        <tr>
                            <th style="width:42%">PRODUCT</th>
                            <th>UNIT</th>
                            <th>QUANTITY</th>
                            <th>UNIT COST (৳)</th>
                            <th>LINE TOTAL (৳)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="purchaseLines">
                        <tr class="create-line-row">
                            <td>
                                <select name="productIds" class="create-product-select" required>
                                    <option value="">Select product</option>
                                    @foreach (var product in products)
                                    {
                                        <option value="@product.ProductId"
                                                data-unit="@product.BaseUnit"
                                                data-cost="@product.DefaultPurchaseUnitCost">
                                            @product.Name (@product.Sku)
                                        </option>
                                    }
                                </select>
                            </td>
                            <td class="create-unit">—</td>
                            <td><input name="quantities" class="create-quantity" type="number" min="0.01" step="0.01" value="1" required /></td>
                            <td><input name="unitCosts" class="create-cost" type="number" min="0" step="0.01" value="0.00" required /></td>
                            <td class="create-line-total">৳0.00</td>
                            <td><button type="button" class="create-remove-line" title="Remove row"><i class="bi bi-trash3"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="create-add-mobile">
                <button type="button" class="create-add-line" id="addLineButtonMobile">
                    <i class="bi bi-plus-lg"></i> Add another product
                </button>
            </div>

            <div class="create-total-row">
                <span>Estimated order total</span>
                <strong id="purchaseGrandTotal">৳0.00</strong>
            </div>
            <p class="create-total-hint">This is an estimate calculated from ordered quantities and unit costs. Inventory is updated only when goods are received through GRN.</p>
        </section>

        <section class="create-card">
            <div class="create-card-heading">
                <div>
                    <h2><span>03</span> Additional notes</h2>
                    <p>Optional information for this purchase order.</p>
                </div>
            </div>
            <div class="create-field">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" rows="3" placeholder="Add delivery instructions or internal notes..."></textarea>
            </div>
        </section>

        <div class="create-actions">
            <a class="purchase-btn purchase-btn-light" asp-controller="Purchase" asp-action="Index">Cancel</a>
            <button type="submit" class="purchase-btn purchase-btn-primary">
                <i class="bi bi-file-earmark-check"></i> Save as draft
            </button>
        </div>
    </form>
</div>

<script>
    (() => {
        const body = document.getElementById('purchaseLines');
        const addButtons = [
            document.getElementById('addLineButton'),
            document.getElementById('addLineButtonMobile')
        ].filter(Boolean);
        const grandTotal = document.getElementById('purchaseGrandTotal');
        const supplierSelect = document.getElementById('supplierId');
        const supplierAddress = document.getElementById('supplierAddress');

        const productOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        products.Select(p => new { id = p.ProductId, label = $"{p.Name} ({p.Sku})", unit = p.BaseUnit, cost = p.DefaultPurchaseUnitCost })
                ));

        function money(value) {
            return new Intl.NumberFormat('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(value);
        }

        function updateTotals() {
            let total = 0;
            body.querySelectorAll('.create-line-row').forEach(row => {
                const qty = Number(row.querySelector('.create-quantity').value) || 0;
                const cost = Number(row.querySelector('.create-cost').value) || 0;
                const lineTotal = qty * cost;
                row.querySelector('.create-line-total').textContent = `৳${money(lineTotal)}`;
                total += lineTotal;
            });
            grandTotal.textContent = `৳${money(total)}`;
        }

        function bindRow(row) {
            const select = row.querySelector('.create-product-select');
            const quantity = row.querySelector('.create-quantity');
            const cost = row.querySelector('.create-cost');
            const unit = row.querySelector('.create-unit');

            select.addEventListener('change', () => {
                const option = select.selectedOptions[0];
                unit.textContent = option?.dataset.unit || '—';
                if (option && option.value) {
                    cost.value = Number(option.dataset.cost || 0).toFixed(2);
                }
                updateTotals();
            });
            quantity.addEventListener('input', updateTotals);
            cost.addEventListener('input', updateTotals);
            row.querySelector('.create-remove-line').addEventListener('click', () => {
                if (body.querySelectorAll('.create-line-row').length === 1) {
                    select.value = '';
                    unit.textContent = '—';
                    quantity.value = '1';
                    cost.value = '0.00';
                } else {
                    row.remove();
                }
                updateTotals();
            });
        }

        function addRow() {
            const row = document.createElement('tr');
            row.className = 'create-line-row';

            const options = productOptions.map(p =>
                `<option value="${p.id}" data-unit="${String(p.unit).replaceAll('"', '&quot;')}" data-cost="${p.cost}">${String(p.label).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')}</option>`
            ).join('');

            row.innerHTML = `
                <td><select name="productIds" class="create-product-select" required>
                    <option value="">Select product</option>${options}
                </select></td>
                <td class="create-unit">—</td>
                <td><input name="quantities" class="create-quantity" type="number" min="0.01" step="0.01" value="1" required /></td>
                <td><input name="unitCosts" class="create-cost" type="number" min="0" step="0.01" value="0.00" required /></td>
                <td class="create-line-total">৳0.00</td>
                <td><button type="button" class="create-remove-line" title="Remove row"><i class="bi bi-trash3"></i></button></td>`;
            body.appendChild(row);
            bindRow(row);
            updateTotals();
        }

        addButtons.forEach(button => button.addEventListener('click', addRow));
        body.querySelectorAll('.create-line-row').forEach(bindRow);

        supplierSelect.addEventListener('change', () => {
            const option = supplierSelect.selectedOptions[0];
            supplierAddress.textContent = option?.dataset.address || 'No supplier address available.';
        });

        document.getElementById('purchaseForm').addEventListener('submit', event => {
            const rows = [...body.querySelectorAll('.create-line-row')];
            const ids = rows.map(row => row.querySelector('.create-product-select').value);
            if (rows.length === 0 || ids.some(id => !id)) {
                event.preventDefault();
                alert('Please select a product for every order line.');
                return;
            }
            if (new Set(ids).size !== ids.length) {
                event.preventDefault();
                alert('A product can only appear once in this order. Update its quantity instead.');
            }
        });

        updateTotals();
    })();
</script>
