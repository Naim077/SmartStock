@model AIMS.Web.Ui.Models.UserFormViewModel
@{
    var roles = (IEnumerable<string>)ViewBag.RoleList;
    var isEdit = Model.UserId != Guid.Empty;
}
<form asp-controller="Users" asp-action="@ViewBag.FormAction" asp-route-id="@(isEdit ? Model.UserId : null)" method="post" class="card" style="padding:24px">
    @Html.AntiForgeryToken()
    <input asp-for="UserId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid">
        <label>Display name<input asp-for="DisplayName" class="form-control" required /></label>
        <span asp-validation-for="DisplayName" class="text-danger"></span>
        <label>Email address<input asp-for="Email" type="email" class="form-control" required /></label>
        <span asp-validation-for="Email" class="text-danger"></span>
        @if (!isEdit)
        {
            <label>Initial password<input asp-for="Password" type="password" class="form-control" minlength="8" autocomplete="new-password" required /></label>
            <span asp-validation-for="Password" class="text-danger"></span>
        }
        else
        {
            <label>New password (optional)<input asp-for="Password" type="password" class="form-control" minlength="8" autocomplete="new-password" placeholder="Leave blank to keep current password" /></label>
            <span asp-validation-for="Password" class="text-danger"></span>
        }
        <label>Role
            <select asp-for="Role" class="form-control">
                <option value="">No role</option>
                @foreach (var role in roles) { <option value="@role">@role</option> }
            </select>
        </label>
        <label><input asp-for="IsActive" /> Active account</label>
    </div>
    <p class="page-description">Account deletion is replaced with deactivation to preserve historical transaction and audit references.</p>
    <div class="page-actions" style="margin-top:20px">
        <a asp-controller="Users" asp-action="Index" class="button button-secondary">Cancel</a>
        <button type="submit" class="button button-primary">Save user</button>
    </div>
</form>
