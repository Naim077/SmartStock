@using AIMS.Entities
@model AIMS.Web.Ui.Models.StockAdjustmentViewModel
@{
    var products = (IEnumerable<Product>)ViewBag.Products;
    var batches = (IEnumerable<ProductBatch>)ViewBag.Batches;
    var isEdit = Model.DocumentId > 0;
}
<form asp-controller="Stock" asp-action="@ViewBag.FormAction" asp-route-id="@(isEdit ? Model.DocumentId : null)" method="post" class="card" style="padding:24px">
    @Html.AntiForgeryToken()
    <input asp-for="DocumentId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-grid">
        <label>Change type<input asp-for="ChangeKind" class="form-control" required /></label>
        <label>Evidence reference<input asp-for="EvidenceReference" class="form-control" /></label>
        <label style="grid-column:1/-1">Reason<textarea asp-for="Reason" class="form-control" rows="3" required></textarea></label>
    </div>
    <h2 class="card-title" style="margin-top:24px">Adjustment lines</h2>
    <p class="page-description">Use a positive quantity to add stock and a negative quantity to reduce it. Select a batch that belongs to the chosen product.</p>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th>Product</th><th>Batch</th><th>Bucket</th><th>Quantity change (+ / -)</th><th></th></tr></thead>
        <tbody id="adjustment-lines">
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                <tr class="adjustment-line">
                    <td><select name="Lines[@i].ProductId" class="form-control" required>
                        <option value="">Select product</option>
                        @foreach (var product in products) { <option value="@product.ProductId" selected="@(Model.Lines[i].ProductId == product.ProductId)">@product.Name (@product.Sku)</option> }
                    </select></td>
                    <td><select name="Lines[@i].ProductBatchId" class="form-control" required>
                        <option value="">Select batch</option>
                        @foreach (var batch in batches) { <option value="@batch.ProductBatchId" selected="@(Model.Lines[i].ProductBatchId == batch.ProductBatchId)">@batch.ProductBatchId - @(batch.IsUnbatched ? "Unbatched" : batch.BatchNumber ?? "Batch")</option> }
                    </select></td>
                    <td><input name="Lines[@i].Bucket" value="@Model.Lines[i].Bucket" class="form-control" placeholder="Stock bucket" required /></td>
                    <td><input name="Lines[@i].QuantityDelta" value="@Model.Lines[i].QuantityDelta" type="number" step="0.01" class="form-control" required /></td>
                    <td><button type="button" class="button button-secondary remove-adjustment-line">Remove</button></td>
                </tr>
            }
        </tbody>
    </table></div>
    <template id="adjustment-line-template">
        <tr class="adjustment-line">
            <td><select name="Lines[__index__].ProductId" class="form-control" required>
                <option value="">Select product</option>
                @foreach (var product in products) { <option value="@product.ProductId">@product.Name (@product.Sku)</option> }
            </select></td>
            <td><select name="Lines[__index__].ProductBatchId" class="form-control" required>
                <option value="">Select batch</option>
                @foreach (var batch in batches) { <option value="@batch.ProductBatchId">@batch.ProductBatchId - @(batch.IsUnbatched ? "Unbatched" : batch.BatchNumber ?? "Batch")</option> }
            </select></td>
            <td><input name="Lines[__index__].Bucket" class="form-control" placeholder="Stock bucket" required /></td>
            <td><input name="Lines[__index__].QuantityDelta" value="0" type="number" step="0.01" class="form-control" required /></td>
            <td><button type="button" class="button button-secondary remove-adjustment-line">Remove</button></td>
        </tr>
    </template>
    <div class="page-actions" style="margin-top:16px">
        <button type="button" id="add-adjustment-line" class="button button-secondary">Add line</button>
        <span class="page-description">Saving creates a Draft only; it does not alter stock balances.</span>
    </div>
    <div class="page-actions" style="margin-top:20px">
        <a asp-controller="Stock" asp-action="Adjustments" class="button button-secondary">Cancel</a>
        <button type="submit" class="button button-primary">Save adjustment draft</button>
    </div>
</form>
<script>
(() => {
    const body = document.getElementById('adjustment-lines');
    const template = document.getElementById('adjustment-line-template');
    const add = document.getElementById('add-adjustment-line');
    if (!body || !template || !add) return;
    const renumber = () => {
        [...body.querySelectorAll('tr.adjustment-line')].forEach((row, index) => {
            row.querySelectorAll('[name]').forEach(input => {
                input.name = input.name.replace(/Lines\[\d+\]/, 'Lines[' + index + ']');
            });
        });
    };
    add.addEventListener('click', () => {
        const index = body.querySelectorAll('tr.adjustment-line').length;
        body.insertAdjacentHTML('beforeend', template.innerHTML.replaceAll('__index__', index));
    });
    body.addEventListener('click', event => {
        const button = event.target.closest('.remove-adjustment-line');
        if (!button || body.querySelectorAll('tr.adjustment-line').length <= 1) return;
        button.closest('tr').remove();
        renumber();
    });
})();
</script>
