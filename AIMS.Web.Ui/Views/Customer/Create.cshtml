@model AIMS.Entities.Customer
@{
    ViewData["Title"] = "Add customer";
    Layout = "_PrivateLayout";
}
<link rel="stylesheet" href="~/css/Customer/Customer.css" asp-append-version="true" />
<div class="customer-page customer-form-page">
    <div class="customer-heading">
        <div><div class="customer-eyebrow">CUSTOMER DIRECTORY</div><h1>Add customer</h1><p>Enter customer contact and account information.</p></div>
        <a asp-action="Index" class="customer-btn customer-btn-light"><i class="bi bi-arrow-left"></i> Back to customers</a>
    </div>
    <form asp-action="Create" method="post" class="customer-form-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="customer-validation"></div>
        <div class="customer-form-grid">
            <div class="customer-field">
                <label asp-for="Name">Customer name <span>*</span></label>
                <input asp-for="Name" placeholder="Enter customer name" required />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="customer-field">
                <label asp-for="Phone">Phone number</label>
                <input asp-for="Phone" placeholder="+880..." />
            </div>
            <div class="customer-field">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" placeholder="customer@example.com" />
            </div>
            <div class="customer-field">
                <label asp-for="CreditLimit">Credit limit (৳)</label>
                <input asp-for="CreditLimit" type="number" min="0" step="0.01" />
            </div>
            <div class="customer-field customer-field-full">
                <label asp-for="Address">Address</label>
                <textarea asp-for="Address" rows="3" placeholder="Customer address"></textarea>
            </div>
            <div class="customer-field customer-field-full customer-options">
                <label class="customer-check-label">
                    <input asp-for="IsWalkIn" type="checkbox" />
                    <span><strong>Walk-in customer</strong><small>Use this record for counter or point-of-sale transactions.</small></span>
                </label>
                <label class="customer-check-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span><strong>Active customer</strong><small>Active customers can be selected for new sales.</small></span>
                </label>
            </div>
        </div>
        <div class="customer-form-actions">
            <a asp-action="Index" class="customer-btn customer-btn-light">Cancel</a>
            <button type="submit" class="customer-btn customer-btn-primary"><i class="bi bi-check2"></i> Save customer</button>
        </div>
    </form>
</div>

