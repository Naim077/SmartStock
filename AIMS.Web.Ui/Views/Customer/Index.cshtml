@using AIMS.Entities
@model List<Customer>
@{
    ViewData["Title"] = "Customers";
    Layout = "_PrivateLayout";
    var search = ViewBag.Search as string ?? "";
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var selectedType = ViewBag.SelectedType as string ?? "All";
}

<link rel="stylesheet" href="~/css/Customer/Customer.css" asp-append-version="true" />

<div class="customer-page">
    <div class="customer-heading">
        <div>
            <div class="customer-eyebrow">CUSTOMER MANAGEMENT</div>
            <h1>Customers</h1>
            <p>Manage customer profiles, contact information and credit limits.</p>
        </div>
        <a asp-controller="Customer" asp-action="Create" class="customer-btn customer-btn-primary">
            <i class="bi bi-plus-lg"></i> Add customer
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="customer-alert"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
    }

    <section class="customer-stats">
        <article class="customer-stat">
            <div class="customer-stat-top"><span>Total customers</span><i class="bi bi-people"></i></div>
            <strong>@ViewBag.TotalCustomers</strong>
            <small>All customer records</small>
        </article>
        <article class="customer-stat">
            <div class="customer-stat-top"><span>Active customers</span><i class="bi bi-person-check"></i></div>
            <strong>@ViewBag.ActiveCustomers</strong>
            <small>Available for sales</small>
        </article>
        <article class="customer-stat">
            <div class="customer-stat-top"><span>Walk-in customers</span><i class="bi bi-person-walking"></i></div>
            <strong>@ViewBag.WalkInCustomers</strong>
            <small>Point-of-sale customers</small>
        </article>
        <article class="customer-stat">
            <div class="customer-stat-top"><span>Inactive customers</span><i class="bi bi-person-x"></i></div>
            <strong>@ViewBag.InactiveCustomers</strong>
            <small>Currently disabled</small>
        </article>
    </section>

    <section class="customer-list-card">
        <div class="customer-list-header">
            <div>
                <h2>All customers</h2>
                <p>View and maintain your customer directory.</p>
            </div>
            <form asp-controller="Customer" asp-action="Index" method="get" class="customer-filters">
                <div class="customer-search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="search" value="@search" placeholder="Search name, email or phone..." />
                </div>
                <select name="status" aria-label="Filter by status">
                    <option value="All" selected="@(selectedStatus == "All")">All statuses</option>
                    <option value="Active" selected="@(selectedStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(selectedStatus == "Inactive")">Inactive</option>
                </select>
                <select name="type" aria-label="Filter by customer type">
                    <option value="All" selected="@(selectedType == "All")">All types</option>
                    <option value="Registered" selected="@(selectedType == "Registered")">Registered</option>
                    <option value="WalkIn" selected="@(selectedType == "WalkIn")">Walk-in</option>
                </select>
                <button type="submit" class="customer-filter-btn">Filter</button>
            </form>
        </div>

        <div class="customer-table-wrap">
            <table class="customer-table">
                <thead>
                    <tr>
                        <th>CUSTOMER</th>
                        <th>PHONE / EMAIL</th>
                        <th>ADDRESS</th>
                        <th>CREDIT LIMIT</th>
                        <th>CUSTOMER TYPE</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7">
                        <div class="customer-empty">
                            <i class="bi bi-people"></i>
                            <strong>No customers found</strong>
                            <span>Add a customer or adjust your search filters.</span>
                        </div>
                    </td></tr>
                }
                else
                {
                    @foreach (var customer in Model)
                    {
                        var firstLetter = string.IsNullOrWhiteSpace(customer.Name) ? "?" : customer.Name.Trim()[0].ToString().ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="customer-name-cell">
                                    <span class="customer-avatar">@firstLetter</span>
                                    <span>
                                        <strong>@customer.Name</strong>
                                        <small>CUS-@customer.CustomerId.ToString("D4")</small>
                                    </span>
                                </div>
                            </td>
                            <td>
                                <div class="customer-contact">
                                    <span>@(string.IsNullOrWhiteSpace(customer.Phone) ? "—" : customer.Phone)</span>
                                    <small>@(string.IsNullOrWhiteSpace(customer.Email) ? "No email" : customer.Email)</small>
                                </div>
                            </td>
                            <td><span class="customer-address" title="@customer.Address">@(string.IsNullOrWhiteSpace(customer.Address) ? "—" : customer.Address)</span></td>
                            <td class="customer-credit">৳@customer.CreditLimit.ToString("N2")</td>
                            <td>
                                <span class="customer-type @(customer.IsWalkIn ? "walkin" : "registered")">
                                    @(customer.IsWalkIn ? "Walk-in" : "Registered")
                                </span>
                            </td>
                            <td>
                                <span class="customer-status @(customer.IsActive ? "active" : "inactive")">
                                    @(customer.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="customer-row-actions">
                                    <a asp-controller="Customer" asp-action="Edit" asp-route-id="@customer.CustomerId" title="Edit customer">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-controller="Customer" asp-action="ToggleStatus" asp-route-id="@customer.CustomerId" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="@(customer.IsActive ? "Deactivate" : "Activate") customer">
                                            <i class="bi @(customer.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="customer-table-footer">
            <span>Showing <strong>@Model.Count</strong> customer(s)</span>
            <span>Credit amounts in BDT (৳)</span>
        </div>
    </section>
</div>
