@using AIMS.Entities
@model List<AiChatLog>
@{
    ViewData["Title"] = "AI Assistant";
    Layout = "_PrivateLayout";
}
<main class="main-content" id="main-content">
    <section class="page-heading"><div><span class="eyebrow">AI INVENTORY ASSISTANT</span><h1>AI Assistant</h1><p class="page-description">Review saved conversations. Chat generation requires an AI service integration.</p></div></section>
    @if (TempData["SuccessMessage"] != null) { <div class="notice notice-success">@TempData["SuccessMessage"]</div> }
    @if (TempData["ErrorMessage"] != null) { <div class="notice notice-warning">@TempData["ErrorMessage"]</div> }
    <div class="notice notice-warning">The chat interface is not connected to an AI provider yet. This page currently displays saved conversation history only.</div>
    <section class="card"><div class="card-header"><h2 class="card-title">Your recent conversations</h2></div><div class="table-wrap"><table class="data-table"><thead><tr><th>Started</th><th>Question</th><th>Status</th><th>Provider / model</th><th>Duration</th><th>Actions</th></tr></thead><tbody>
    @if (!Model.Any()) { <tr><td colspan="6">No assistant conversations found.</td></tr> }
    @foreach (var chat in Model) { <tr><td>@chat.StartedUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td><td>@chat.QuestionRedacted</td><td>@chat.Status</td><td>@(chat.Provider ?? "—") / @(chat.Model ?? "—")</td><td>@(chat.LatencyMilliseconds.HasValue ? $"{chat.LatencyMilliseconds} ms" : "—")</td>
        <td>
            @if (!chat.LegalHold)
            {
                <form asp-controller="AiAssistant" asp-action="Delete" asp-route-id="@chat.AiChatLogId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="button button-secondary" onclick="return confirm('Delete this conversation history?')">Delete history</button>
                </form>
            }
            else { <span>Legal hold</span> }
        </td></tr> }
    </tbody></table></div></section>
</main>