@{
    Layout = "_PrivateLayout";
}
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20viewBox%3D%270%200%2032%2032%27%3E%3Crect%20width%3D%2732%27%20height%3D%2732%27%20rx%3D%278%27%20fill%3D%27%23244b34%27%2F%3E%3Cpath%20d%3D%27m16%206%2010%206-10%206-10-6Zm-10%2011%2010%206%2010-6%27%20stroke%3D%27%23cee1bc%27%20fill%3D%27none%27%20stroke-width%3D%272%27%2F%3E%3C%2Fsvg%3E">
<link rel="stylesheet" href="~/css/styles.css" />

<dialog id="app-modal" class="modal modal-wide" aria-labelledby="modal-title" open="">
    <form id="modal-form" class="modal-form">
        <div class="modal-header">
            <h2 id="modal-title">Add a product</h2>
            <button type="button" class="icon-button" data-close-modal="" aria-label="Close dialog">
                <svg class="icon" aria-hidden="true">
                    <use href="#i-close">
                    </use>
                </svg>
            </button>
        </div>
        <div id="modal-body" class="modal-body">
            <div class="stack">
                <div class="notice notice-info">New products start with zero stock and zero weighted cost. Receive a purchase or approve a stock request to introduce inventory.</div>
                <div class="form-grid">
                    <div class="field full"><label for="product-name">Product name</label><input id="product-name" name="name" value="" maxlength="120" required=""></div>
                    <div class="field"><label for="product-sku">Unique Product Code</label><input id="product-sku" name="sku" value="" maxlength="40" required=""></div>
                    <div class="field"><label for="product-barcode">Barcode <span class="text-muted">(optional)</span></label><input id="product-barcode" name="barcode" value="" maxlength="64"></div>
                    <div class="field"><label for="product-category">Category</label><select id="product-category" name="category" required=""><option value="Electronics" selected="">Electronics</option><option value="Groceries">Groceries</option><option value="Household">Household</option><option value="Lifestyle">Lifestyle</option><option value="Stationery">Stationery</option></select></div>
                    <div class="field"><label for="product-unit">Unit name</label><input id="product-unit" name="unit" value="piece" maxlength="30" required=""><small class="text-muted">Stock is recorded in whole units.</small></div>
                    <div class="field full"><label for="product-supplier">Preferred supplier</label><select id="product-supplier" name="supplierId" required=""><option value="">Choose an active supplier</option><option value="S001" selected="">Orbit Electronics</option><option value="S002">Paper &amp; Co.</option><option value="S003">Everyday Essentials</option><option value="S004">Greenfield Foods</option></select></div>
                    <div class="field"><label for="product-purchase-cost">Default purchase cost (BDT)</label><input id="product-purchase-cost" name="purchaseCost" type="number" min="0" max="1000000000" step="0.01" value="0" required=""></div>
                    <div class="field"><label for="product-price">Selling price (BDT)</label><input id="product-price" name="price" type="number" min="0.01" max="1000000000" step="0.01" value="0" required=""></div>
                    <div class="field"><label for="product-reorder">Reorder level</label><input id="product-reorder" name="reorder" type="number" min="0" max="10000000" step="1" value="10" required=""></div>
                    <div class="field"><label for="product-expiry">Expiry date <span class="text-muted">(optional)</span></label><input id="product-expiry" name="expiry" type="date" value=""></div>
                    <div class="field full"><label for="product-description">Description <span class="text-muted">(optional)</span></label><textarea id="product-description" name="description" rows="3" maxlength="1000"></textarea></div>
                </div><div class="notice notice-info">Confirming changes this browser-local demo only. No supplier message, real payment, or server transaction is sent.</div>
            </div>
        </div>
        <p id="modal-error" class="modal-error" role="alert" tabindex="-1" hidden="">
        </p>
        <div class="modal-footer">
            <button id="modal-cancel" type="button" class="button button-secondary" data-close-modal="">Cancel</button>
            <button id="modal-submit" type="submit" class="button button-primary">Confirm new product</button>
        </div>
    </form>
</dialog>

<partial name="_ValidationScriptsPartial" />
<script src="~/js/app.js"></script>
<script src="~/js/operations.js"></script>